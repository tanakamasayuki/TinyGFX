# 実機テスト用のシリアルポート。**このファイルを .env に写して書き換える。**
#
#   uv run --env-file .env pytest hw --profile m5stack
#
# .env を渡さなければ実機テストは skip される（素の `uv run pytest` は実機を焼かない）。
#
# 安定した名前が要るなら board-identify の by-id を使う:
#   TEST_SERIAL_PORT_M5STACK=/run/board-identify/by-id/esp32-xxxx-yyyy

TEST_SERIAL_PORT=/dev/ttyUSB0
TEST_SERIAL_PORT_M5STACK=/dev/ttyUSB0
